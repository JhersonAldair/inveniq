digraph ER {
  rankdir=LR; fontname="Helvetica"; nodesep=0.5; ranksep=1.0;
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#23405f", arrowhead=crow, arrowtail=none, dir=both, arrowtail=tee];
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#0b4f8a"><tr><td bgcolor="#0b4f8a"><font color="white"><b>users</b></font></td></tr><tr><td align="left"><b>PK</b> id<br align="left"/>name<br align="left"/>email (único)<br align="left"/>passwordHash<br align="left"/>role (administrador | operador)<br align="left"/>active<br align="left"/></td></tr></table>>];
  warehouses [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#0b4f8a"><tr><td bgcolor="#0b4f8a"><font color="white"><b>warehouses</b></font></td></tr><tr><td align="left"><b>PK</b> id<br align="left"/>name (único)<br align="left"/>city, address<br align="left"/>latitude, longitude<br align="left"/>capacity (&gt; 0)<br align="left"/>active<br align="left"/></td></tr></table>>];
  products [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#0b4f8a"><tr><td bgcolor="#0b4f8a"><font color="white"><b>products</b></font></td></tr><tr><td align="left"><b>PK</b> id<br align="left"/>sku (único)<br align="left"/>name, category, unit<br align="left"/>unitCost (&#8805; 0)<br align="left"/>minStock<br align="left"/>active<br align="left"/></td></tr></table>>];
  stocks [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#15803d"><tr><td bgcolor="#15803d"><font color="white"><b>stocks</b></font></td></tr><tr><td align="left"><b>PK</b> id<br align="left"/><b>FK</b> productId<br align="left"/><b>FK</b> warehouseId<br align="left"/>quantity (&#8805; 0)<br align="left"/>único (productId, warehouseId)<br align="left"/></td></tr></table>>];
  movements [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#d97706"><tr><td bgcolor="#d97706"><font color="white"><b>movements</b></font></td></tr><tr><td align="left"><b>PK</b> id<br align="left"/><b>FK</b> productId, warehouseId, userId<br align="left"/>type (entrada | salida)<br align="left"/>quantity (&gt; 0)<br align="left"/>reference, notes<br align="left"/>status (registrado | anulado)<br align="left"/></td></tr></table>>];
  products -> stocks; warehouses -> stocks; products -> movements; warehouses -> movements; users -> movements;
}
